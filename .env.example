# nanobuddy-agent 环境变量模板
# 用法：复制为 .env 后按需填写；.env 已被 gitignore，不会提交

# ── 必填（首次部署）──
# 管理员登录密码（设置页登录用）
NANOBUDDY_ADMIN_PASSWORD=请改成你的管理员密码

# ── 建议填写 ──
# JWT 签名密钥：至少 32 字节的随机串；不填则自动生成并存于 data/security/jwt_secret
# 注意：更换后已颁发的登录 token 全部失效，需重新登录
NANOBUDDY_JWT_SECRET=

# 服务级 API Key（供外部系统调用本软件 API 时鉴权，可选）
NANOBUDDY_API_KEY=

# ── 模型 API Key（DeepSeek / OpenAI 等）──
# 不在这里填写。启动软件后进入「设置 → 模型配置」页面填写，
# 保存后立即生效，且只存于软件自身数据库，不写入本文件。
# （此处留空即可；页面未填写时以下 .env 值作为兜底）
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# ── 可选集成 ──
# Tavily 联网搜索（不填则搜索工具不可用）
# TAVILY_API_KEY=
# 飞书机器人（不用可忽略）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# ── 运行参数（均有默认值，可不填）──
# NANOBUDDY_HOST=0.0.0.0
# NANOBUDDY_PORT=8000
